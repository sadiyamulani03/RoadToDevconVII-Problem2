# Copy this file to .env and fill in the values you need.
# NEVER commit .env or any real credential to the repository.

# ── LLM ────────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible chat-completions API.
# LLM_API_KEY is required for the full question-answering pipeline
# (`npm run answer`, the web UI, POST /api/search).
LLM_API_KEY=
# Optional overrides (defaults shown):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_JSON_MODE=1

# ── Sepolia RPC ───────────────────────────────────────────────────────────────
# Optional. Defaults to viem's keyless public Sepolia RPC.
# Any public Sepolia endpoint works, e.g.:
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Seeding only (scripts/seed-community.ts) ─────────────────────────────────
# PRIVATE_KEY is used EXCLUSIVELY by the optional seed script that creates the
# community subnames + text records on Sepolia. The application itself never
# needs or reads a private key. Use a throwaway test wallet, never a real one.
PRIVATE_KEY=
